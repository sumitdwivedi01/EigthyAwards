# Copy to Backend/.env.live (Git ignores it) to wipe, seed and fill the PRODUCTION database from
# your laptop (docs/DEMO.md). Never commit the copy. Only these scripts read it:
#   npm run db:wipe, npx prisma db seed, npm run demo:data   (with ENV_FILE=.env.live)

# Supabase: the same connection strings the Render service uses (Render → Environment).
# If the direct connection (db.<project>.supabase.co) doesn't connect from your network (it is
# IPv6 only), use the "Session pooler" string from Supabase → Connect, port 5432, for both.
DATABASE_URL=postgresql://postgres.<project>:<password>@<host>:5432/postgres
DIRECT_URL=postgresql://postgres.<project>:<password>@<host>:5432/postgres
DATABASE_SSL=require

# The live site (Vercel): the demo script talks to the API through it, as a browser does.
APP_URL=https://<your-site>.vercel.app

# Not used by these scripts, but the configuration check needs a value: any 32+ characters.
AUTH_SECRET=only-for-the-config-check-not-used-by-the-scripts

# The demo's passwords. Choose new, strong ones: the seed gives every demo account these.
# Share them with the lead privately; never put them in Git, chat or a document.
LEADER_EMAIL=leader@demo.test
LEADER_PASSWORD=
DEMO_PASSWORD=
