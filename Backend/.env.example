# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=4000
# The frontend origin: used for CORS and for links in emails.
APP_URL=http://localhost:3000

# Runtime connection (in production: Supabase's pooled connection string).
DATABASE_URL=postgresql://awards:awards@localhost:5433/awards
# Migrations connection (in production: Supabase's direct or session connection string).
DIRECT_URL=postgresql://awards:awards@localhost:5433/awards
# Automated tests use their own database. Must contain "test".
TEST_DATABASE_URL=postgresql://awards:awards@localhost:5433/awards_test
# Scratch database for the drift check (local and CI only).
SHADOW_DATABASE_URL=postgresql://awards:awards@localhost:5433/awards_shadow

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-me-with-at-least-32-random-characters
# How long a login lasts, in hours.
SESSION_MAX_AGE_HOURS=12
# Proxies in front of the API: 1 locally (the Next.js /api proxy).
TRUST_PROXY=1

# Email. Locally Mailpit catches everything (inbox: http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Awards Platform <no-reply@awards.local>"

# Files: "disk" locally; Supabase Storage online, from Step 1.5 (14 Oct).
STORAGE_DRIVER=disk
STORAGE_DISK_ROOT=./storage

LOG_LEVEL=info

# Seed (npm run db:seed): the leader's account and the password of every demo account.
# Choose your own; they never go into Git. The leader's team uses the leader's account (ADR 0014).
LEADER_EMAIL=leader@demo.test
LEADER_PASSWORD=
DEMO_PASSWORD=
